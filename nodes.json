    "web_mirror": {
      "description": "GitHub网页完整镜像，可直接浏览",
      "default_url_template": "{node_url}/{path}",
      "nodes": [
        {
          "id": "kkgithub",
          "name": "KKGitHub",
          "url": "https://kkgithub.com",
          "supports": [
            "web",
            "release",
            "clone"
          ],
          "notes": "界面与GitHub一致"
        }
      ]
    },
    "clone_specialized": {
      "description": "Git Clone专用加速",
      "default_url_template": "{node_url}/github.com/{owner}/{repo}.git",
      "nodes": [
        {
          "id": "gitclone-com",
          "name": "GitClone",
          "url": "https://gitclone.com",
          "url_template": "{node_url}/github.com/{owner}/{repo}.git",
          "supports": [
            "clone"
          ],
          "location": "中国杭州"
        }
      ]
    },
    "cdn_raw": {
      "description": "CDN加速，仅支持raw/blob文件，不支持release大文件",
      "default_url_template": "https://{node_url}/gh/{owner}/{repo}@{ref}/{path}",
      "nodes": [
        {
          "id": "jsdelivr-cdn",
          "name": "jsDelivr CDN",
          "url": "cdn.jsdelivr.net",
          "url_template": "https://{node_url}/gh/{owner}/{repo}@{ref}/{path}",
